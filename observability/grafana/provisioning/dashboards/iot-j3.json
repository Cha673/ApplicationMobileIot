          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT received_at::timestamptz AS time, 'accepted' AS type, device_id, temperature::text AS detail FROM measurements WHERE received_at::timestamptz BETWEEN $__timeFrom() AND $__timeTo() UNION ALL SELECT rejected_at AS time, 'rejected', device_id, reason AS detail FROM rejected_events WHERE rejected_at BETWEEN $__timeFrom() AND $__timeTo() UNION ALL SELECT detected_at AS time, 'duplicate', device_id, message_id AS detail FROM duplicate_events WHERE detected_at BETWEEN $__timeFrom() AND $__timeTo() ORDER BY time DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Flux temps réel — tous les événements",
      "type": "table"
